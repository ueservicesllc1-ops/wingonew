rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if true; // Anyone can read events
      allow write: if false; // Only admins can write (via Firebase Console or Functions)
    }
    
    // Bets collection
    match /bets/{betId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Bets can't be modified or deleted
    }
    
    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Transactions can't be modified or deleted
    }
    
    // Banners collection (para el Hero Slider)
    match /banners/{bannerId} {
      allow read: if true; // Todos pueden leer los banners
      allow write: if true; // Temporalmente permitir a todos (cambiar después por auth admin)
    }
    
    // Promotions collection
    match /promotions/{promotionId} {
      allow read: if true; // Todos pueden leer las promociones
      allow write: if true; // Temporalmente permitir a todos (cambiar después por auth admin)
    }
    
    // Messages collection (mensajes de contacto)
    match /messages/{messageId} {
      allow read: if true; // Admins pueden leer todos los mensajes
      allow create: if true; // Cualquiera puede crear un mensaje de contacto
      allow update: if true; // Solo admins pueden actualizar (marcar como leído)
      allow delete: if true; // Solo admins pueden eliminar
    }
  }
}
